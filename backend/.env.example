# Copy to .env and fill in. The app runs without any of these (in-memory store,
# demo AI fallbacks) — set them to enable the real services.

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Database (MongoDB Atlas). Without it, an in-memory store is used. ---
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=numanos

# --- AI (Anthropic Claude) for email generation + RAG assistant ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Server ---
PORT=5000
